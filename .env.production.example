# ════════════════════════════════════════════════════════════════
#  AI 面试系统 —— 生产环境变量模板
#  用法：复制为 .env.production 并填入真实值（该文件含密钥，切勿提交）
#  注意：模型名/BaseURL/API Key 这类配置若已在系统「设置」页保存，
#        则以数据库为准，此处留空即可（下方标注了哪些属于这种情况）
# ════════════════════════════════════════════════════════════════

# ── 平台共享密钥（必填）────────────────────────────────────────
# 一把 key 通吃 LLM / ASR / 实时语音；若在设置页单独配了 LLM key 与
# 实时语音 key，则该项可留空。
QWEN_API_KEY=

# ── 部署地址（构建期已内联，这里主要用于运行时兜底）──────────────
NEXT_PUBLIC_SITE_URL=http://106.54.6.25
NEXT_PUBLIC_LIVE_URL=http://106.54.6.25

# ── 数据库与存储 ───────────────────────────────────────────────
SQLITE_DB_PATH=/app/data/foloup.db
PROCTORING_STORAGE_DIR=/app/data/proctoring

# ── 设置项加密密钥（⚠️ 保持留空）────────────────────────────────
# 留空时会使用 data/settings.key。若你迁移了旧库里的加密密钥，
# 一旦这里填了别的值，旧密钥将无法解密。
SETTINGS_ENCRYPTION_KEY=

# ════════════ 以下可选；已在设置页配置过的无需填写 ════════════
# LLM_MODEL=deepseek-flash
# LLM_BASE_URL=https://api.deepseek.com
# LLM_API_KEY=
# LLM_MAX_TOKENS=4000
# LLM_TIMEOUT_MS=50000
# LLM_JSON_MODE=1
# QWEN_REALTIME_API_KEY=
# QWEN_REALTIME_WS_URL=wss://maas.qianwenaiapi.com/api-ws/v1/realtime
# QWEN_REALTIME_MODEL=qwen3.8-omni-flash-realtime
# QWEN_REALTIME_ASR_MODEL=qwen3-asr-flash-realtime

# ── 候选人隐私与留存（构建期内联，改动需重新构建镜像）──────────
NEXT_PUBLIC_DATA_RETENTION_MONTHS=6
# NEXT_PUBLIC_PRIVACY_CONTACT_EMAIL=
