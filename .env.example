# ════════════════════════════════════════════════════════════════
#  AI 面试系统 —— 环境变量模板
#  用法：把本文件复制成 .env，按需填写文本模型与实时语音的配置。
#  （.env 已被 .gitignore 忽略，不会进仓库）
# ════════════════════════════════════════════════════════════════

# ── 兼容旧版：平台共享密钥（可选）──────────────────────────────
# 新部署建议分别配置 LLM_API_KEY 与 QWEN_REALTIME_API_KEY；保留此项可兼容旧数据。
QWEN_API_KEY=

# ── 部署地址：生成候选人链接时用（决定分享出去的链接是否完整）──
# 本地开发填 http://localhost:3000；线上填你的域名，如 https://interview.example.com
NEXT_PUBLIC_LIVE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── 数据库：SQLite 单文件，默认 ./data/foloup.db ────────────────
# 一般不用改；部署时若想把数据放到挂载卷，可指到绝对路径
SQLITE_DB_PATH=

# ── 设置页密钥加密（可选但建议线上配置）──────────────────────────
# 设置页保存的 API Key 会加密写入 SQLite；不填时会在 data/settings.key 生成本机密钥。
SETTINGS_ENCRYPTION_KEY=

# ════════════ 以下全部可选，不填就用默认值 ════════════

# ── 出题 / 评分 / 洞察用的 LLM ─────────────────────────────────
# 换模型只改 LLM_MODEL 一行即可
# 实测可用：deepseek-v4.1-flash（默认，1 元/百万tok，最快）
#           qwen-max / qwen3.8-max / glm-5 / kimi-k2.6 / deepseek-v4-pro（慢，约 35s）
LLM_MODEL=deepseek-v4.1-flash
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 文本模型单独密钥；系统设置页保存的密钥会加密写入 SQLite
LLM_API_KEY=
# ⚠️ 绝不低于 2000：deepseek-v4 系列与 glm-5 的思考过程也吃这个预算，
#    设小了会出现「接口返回 200 但正文为空」
LLM_MAX_TOKENS=4000
LLM_TIMEOUT_MS=50000
# 设 0 则永不发送 response_format=json_object（换到不支持它的模型时兜底用）
LLM_JSON_MODE=1

# ── 实时语音（面试通话）───────────────────────────────────────
# 实时语音单独密钥；不填时兼容回落到 QWEN_API_KEY
QWEN_REALTIME_API_KEY=
# 不同地域/工作空间的 WebSocket 地址可能不同，请按服务商控制台填写；留空时兼容旧版 POC 地址
QWEN_REALTIME_WS_URL=
# 不填则默认 qwen3.8-omni-flash-realtime
QWEN_REALTIME_MODEL=
# 当前实时协议使用的输入语音识别模型
QWEN_REALTIME_ASR_MODEL=qwen3-asr-flash-realtime

# ── 候选人隐私与数据留存（可选）──────────────────────────────
# 留存期限（月）：候选人页与数据删除页会显示"到期日"；默认 6
NEXT_PUBLIC_DATA_RETENTION_MONTHS=6
# 隐私联系邮箱：候选人若对信息处理有疑问，页面上会显示这个联系方式（留空则不显示）
NEXT_PUBLIC_PRIVACY_CONTACT_EMAIL=
